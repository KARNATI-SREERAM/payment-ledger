# Copy to .env to override defaults (docker compose reads .env automatically). No secrets here.
# PostgreSQL (local dev values only; use a real secret manager in production).
# From your Mac: postgresql+psycopg://ledger:ledger@localhost:5434/ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger

# Per-client rate limit on the API (token bucket): long-run requests/s and burst size.
RATE_LIMIT_PER_SEC=50
RATE_LIMIT_BURST=100
# Load test size (docker compose --profile loadtest run --rm locust).
LOCUST_USERS=50
LOCUST_RUN_TIME=60s
